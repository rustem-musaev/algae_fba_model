// ===========================================================================
// eukprok-nf settings. Anything here can also be changed on the command line,
// e.g. --assembler metaspades  or  --repeatmasker_species chlorophyta
// ===========================================================================

manifest {
    name            = 'eukprok-nf'
    description     = 'Eukaryotic + prokaryotic metagenome pipeline (assembly to annotated eukaryotic bins)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    // ---- input / output ----
    input       = null            // samplesheet: sample,fastq_1,fastq_2[,contigs]
    outdir      = 'results'
    publish_mode = 'copy'         // 'copy' or 'symlink'

    // ---- 1. assembly ----
    assembler     = 'megahit'     // 'megahit' or 'metaspades'
    megahit_args  = ''
    spades_args   = ''

    // ---- 2. euk/prok split ----
    min_contig_length     = 1000  // shorter contigs are dropped before DeepMicroClass
    deepmicroclass_device = 'cpu' // 'cpu' or 'cuda' (GPU)
    deepmicroclass_args   = ''

    // ---- 3. binning ----
    metabat_min_contig = 1500     // MetaBAT2 -m (cannot be below 1500)
    metabat_args       = ''

    // ---- 4. quality check ----
    qc_tools            = 'busco,eukcc' // any of: busco, eukcc
    busco_lineage       = 'auto_euk'    // 'auto_euk', 'auto', or a lineage such as 'chlorophyta_odb10'
    busco_download_path = null          // folder with pre-downloaded BUSCO lineages (for nodes without internet)
    busco_args          = ''
    eukcc_db            = null          // EukCC database folder (needed if eukcc is in qc_tools)

    // ---- stop after QC? ----
    skip_gene_prediction = false

    // ---- 5. masking ----
    repeatmasker_species = 'chlorophyta' // taxon name as in NCBI / Dfam
    repeatmasker_lib     = null          // OR a custom repeat library (FASTA), e.g. from RepeatModeler
    repeatmasker_args    = ''

    // ---- 6. gene prediction ----
    genemark_min_contig    = 1000    // drop contigs shorter than this inside GeneMark-ES
    genemark_skip_failures = true    // bins that GeneMark cannot train on are skipped, not fatal
    genemark_args          = ''
    augustus_species       = 'chlamydomonas'
    augustus_extrinsic_cfg = null    // optional custom extrinsic.cfg
    augustus_args          = ''

    // ---- 7. functional annotation ----
    annotation_tools  = 'eggnog'     // any of: eggnog, interproscan  (or 'none')
    eggnog_db         = null         // eggNOG-mapper data folder, e.g. /data/db/eggnog_2.1.11
    eggnog_tax_scope  = 3041         // 3041 = Chlorophyta
    eggnog_args       = ''
    interproscan_cmd  = 'interproscan.sh'  // full path if InterProScan is not on your PATH
    interproscan_args = ''

    // ---- 8. taxonomy ----
    run_eukulele           = true
    eukulele_database      = 'mmetsp'
    eukulele_reference_dir = null    // already-downloaded EUKulele database (otherwise it downloads)
    eukulele_args          = ''
    taxa_list              = null    // text file, one taxon per line -> per-taxon protein files
    kraken2_db             = null    // set this to also run Kraken2 on the assembled contigs
    kraken2_args           = ''

    // ---- cluster (used by -profile slurm / dardel) ----
    slurm_account   = null           // e.g. naiss2025-x-xx
    slurm_partition = 'shared'

    // ---- conda ----
    conda_cache = null               // where conda environments are kept (reuse between runs)
}

// ---------------------------------------------------------------------------
// Resources. Change the numbers to fit your cluster.
// Failed jobs that ran out of memory are retried once with twice the memory.
// ---------------------------------------------------------------------------
process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1

    withLabel: 'process_single' { cpus = 1;  memory = { 8.GB   * task.attempt }; time = 12.h }
    withLabel: 'process_low'    { cpus = 4;  memory = { 16.GB  * task.attempt }; time = 12.h }
    withLabel: 'process_medium' { cpus = 16; memory = { 64.GB  * task.attempt }; time = 24.h }
    withLabel: 'process_high'   { cpus = 32; memory = { 128.GB * task.attempt }; time = 48.h }

    // GeneMark-ES cannot train on very small bins; skip those bins instead of stopping everything
    withName: 'GENEMARK_ES' {
        errorStrategy = { params.genemark_skip_failures ? 'ignore' : 'terminate' }
    }
}

// ---------------------------------------------------------------------------
// Software (used with -profile conda or -profile mamba).
// GeneMark-ES and usually InterProScan must be installed by you (licence /
// very large data); they are taken from your PATH.
// ---------------------------------------------------------------------------
profiles {

    conda {
        includeConfig 'conf/conda.config'
    }

    mamba {
        includeConfig 'conf/conda.config'
        conda.useMamba = true
    }

    // Generic Slurm cluster
    slurm {
        process.executor       = 'slurm'
        process.queue          = { params.slurm_partition }
        process.clusterOptions = { params.slurm_account ? "-A ${params.slurm_account}" : '' }
        executor.queueSize     = 50
        executor.submitRateLimit = '10/1min'
    }

    // PDC Dardel (KTH). Check PDC's pages for current partition limits.
    dardel {
        process.executor       = 'slurm'
        process.queue          = { params.slurm_partition }
        process.clusterOptions = { params.slurm_account ? "-A ${params.slurm_account}" : '' }
        executor.queueSize     = 50
        executor.submitRateLimit = '10/1min'
    }

    // Run everything on the machine you are on (e.g. an interactive node)
    local {
        process.executor = 'local'
    }
}

// Reports that help you see what ran, how long it took and how much memory it used
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
