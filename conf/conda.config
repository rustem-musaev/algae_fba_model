// Software for each step, used by -profile conda and -profile mamba
conda.enabled = true
conda.cacheDir = params.conda_cache ?: "${projectDir}/conda_envs"
conda.createTimeout = '2 h'
process {
    withName: 'MEGAHIT'               { conda = 'bioconda::megahit=1.2.9' }
    withName: 'METASPADES'            { conda = 'bioconda::spades=3.15.5' }
    withName: 'DEEPMICROCLASS'        { conda = "${projectDir}/envs/deepmicroclass.yml" }
    withName: 'MAP_AND_DEPTH'         { conda = 'bioconda::bowtie2 bioconda::samtools bioconda::metabat2' }
    withName: 'METABAT2'              { conda = 'bioconda::metabat2' }
    withName: 'QUAST'                 { conda = 'bioconda::quast' }
    withName: 'EUKCC'                 { conda = 'bioconda::eukcc' }
    withName: 'BUSCO|BUSCO_PLOT'      { conda = 'bioconda::busco=5' }
    withName: 'REPEATMASKER'          { conda = 'bioconda::repeatmasker' }
    withName: 'AUGUSTUS'              { conda = 'bioconda::augustus' }
    withName: 'EGGNOG_MAPPER'         { conda = 'bioconda::eggnog-mapper' }
    withName: 'EUKULELE'              { conda = 'bioconda::eukulele' }
    withName: 'KRAKEN2'               { conda = 'bioconda::kraken2' }
}
